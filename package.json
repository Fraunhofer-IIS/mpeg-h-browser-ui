    "file-loader": "^6.2.0",
    "globals": "^17.14.0 ",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "svg-url-loader": "^8.1.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "url-loader": "^4.1.1",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-license-plugin": "^4.5.1",
    "webpack-merge": "^6.0.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
