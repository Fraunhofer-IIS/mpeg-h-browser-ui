    "type": "git",
    "url": "git+https://github.com/Fraunhofer-IIS/mpeg-h-browser-ui.git"
  },
  "scripts": {
    "clean": "pnpm -r clean",
    "build:all": "pnpm -r build",
    "build:libs": "pnpm -r --filter=./libs/* build",
    "build:libs_to_apps": "pnpm build:libs && node ./copy_libs_to_apps.js",
